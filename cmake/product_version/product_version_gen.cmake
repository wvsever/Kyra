# product_version_gen.cmake -- build-time generator (cmake -P). LaneTools product versioning spec.
# In: PV_PRODUCT, PV_SRC (git work tree), PV_OUT (generated .cpp).
# Rewrites PV_OUT only when the SHA or the dirty flag changed, so the build date stays fixed per HEAD
# and the one object recompiles only then.
set(sha "unknown")
set(cdate "")
set(dirty 0)
find_program(PV_GIT git)
if(PV_GIT)
  execute_process(COMMAND "${PV_GIT}" -C "${PV_SRC}" rev-parse --short=9 HEAD
    OUTPUT_VARIABLE o RESULT_VARIABLE r OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(r EQUAL 0 AND o)
    set(sha "${o}")
    execute_process(COMMAND "${PV_GIT}" -C "${PV_SRC}" log -1 --format=%cs HEAD
      OUTPUT_VARIABLE cdate OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND "${PV_GIT}" -C "${PV_SRC}" status --porcelain --untracked-files=no
      OUTPUT_VARIABLE st ERROR_QUIET)
    if(st)
      set(dirty 1)
    endif()
  endif()
endif()
set(ver "0.0.0")
if(cdate MATCHES "^[0-9][0-9]([0-9][0-9])-([0-9][0-9])-([0-9][0-9])$")
  math(EXPR yy "${CMAKE_MATCH_1}")
  math(EXPR mm "${CMAKE_MATCH_2}")
  math(EXPR dd "${CMAKE_MATCH_3}")
  set(ver "${yy}.${mm}.${dd}")
endif()
set(key "// pv-key ${PV_PRODUCT} ${sha} ${dirty}")
if(EXISTS "${PV_OUT}")
  file(STRINGS "${PV_OUT}" first LIMIT_COUNT 1)
  if(first STREQUAL key)
    return()
  endif()
endif()
string(TIMESTAMP built "%Y-%m-%d" UTC)
if(dirty)
  set(dtxt "true")
else()
  set(dtxt "false")
endif()
set(ln "${PV_PRODUCT} ${ver} sha=${sha} dirty=${dirty} built=${built}")
set(js "{\\\"product\\\":\\\"${PV_PRODUCT}\\\",\\\"version\\\":\\\"${ver}\\\",\\\"sha\\\":\\\"${sha}\\\",\\\"dirty\\\":${dtxt},\\\"build_date\\\":\\\"${built}\\\"}")
file(WRITE "${PV_OUT}.tmp" "${key}
// Generated by product_version_gen.cmake. Do not edit.
#include \"product_version.h\"
#include <cstdio>
#include <cstring>
namespace product_version {
const char* product() { return \"${PV_PRODUCT}\"; }
const char* version() { return \"${ver}\"; }
const char* sha() { return \"${sha}\"; }
bool dirty() { return ${dtxt}; }
const char* build_date() { return \"${built}\"; }
const char* line() { return \"${ln}\"; }
const char* json() { return \"${js}\"; }
int handle(const char* arg) {
  if (arg == nullptr) return -1;
  if (std::strcmp(arg, \"--version\") == 0) { std::puts(line()); return 0; }
  if (std::strcmp(arg, \"--version-json\") == 0) { std::puts(json()); return 0; }
  return -1;
}
}  // namespace product_version
")
file(RENAME "${PV_OUT}.tmp" "${PV_OUT}")
